
#include<stdio.h>
#include<string.h>

int main()
{
    char a[50],b[50];
    int i,choice;

    printf("Enter First string :");
    scanf("%49s",a);

    printf("Enter Second string :");
    scanf("%49s",b);

    printf("1. Length\n2. Copy\n3. Join\n4. Compare\n5. Reverse\nEnter Choice Number=");
    scanf("%d",&choice);

    switch(choice)
{
        case 1:
            printf("Length of first string = %d\n", (int)strlen(a));
            printf("Length of second string = %d\n", (int)strlen(b));
    break;
        case 2:
            strcpy(a, b);
            printf("Copied string = %s", a);
            break;

        case 3:
            strcat(a, b);
            printf("Joined string = %s", a);
            break;

        case 4:
            if(strcmp(a, b) == 0)
                printf("Strings are equal");
            else
                printf("Strings are not equal");
            break;

            case 5:
                printf("Reverse of first string = ");
                for(i = strlen(a) - 1; i >= 0; i--)
                    printf("%c", a[i]);

                printf("\nReverse of second string = ");
                for(i = strlen(b) - 1; i >= 0; i--)
                    printf("%c", b[i]);
                break;

            default:
                printf("Invalid choice");
        }

    return 0;
}




