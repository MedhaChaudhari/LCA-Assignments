#include <stdio.h>

struct Student
{
    int rollno;
    char name[50];
    int m1, m2, m3, total;
    float percentage;
};

int main()
{
    struct Student s[50];
    int n, i;

    printf("Enter number of students: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        printf("\nEnter roll number: ");
        scanf("%d", &s[i].rollno);

        printf("Enter full name: ");
        scanf(" %49s\n", s[i].name);

        printf("Enter marks of 3 subjects: ");
        scanf("%d %d %d", &s[i].m1, &s[i].m2, &s[i].m3);

        s[i].total = s[i].m1 + s[i].m2 + s[i].m3;
        s[i].percentage = s[i].total / 3.0;
    }

    
printf("\n%-11s %-21s %-11s %-11s %-11s %-11s %-11s\n",
       "Roll No", "Name", "Sub1", "Sub2", "Sub3", "Total", "Percentage");

for (i = 0; i < n; i++)
{
    printf("%-11d %-21s %-11d %-11d %-11d %-11d %-11.2f\n",
           s[i].rollno, s[i].name,
           s[i].m1, s[i].m2, s[i].m3,
           s[i].total, s[i].percentage);
}

    return 0;
}
