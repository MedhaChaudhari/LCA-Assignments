#include<stdio.h>

int main()
{
    int a[4][4],b[4][4],c[4][4];
    int r,col,i,j,choice;

    printf("Enter number of rows (1 to 4) = ");
    scanf("%d", &r);

    printf("Enter number of columns (1 to 4) = ");
    scanf("%d", &col);

    if(r<1 || r>4 || col<1 || col>4)
    {
        printf("Invalid rows & column Input!\n");
        return 0;
    } 

    printf("Enter elements of first matrix:\n");
    for(i = 0; i < r; i++)
    {
        for(j = 0; j < col; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    printf("Enter elements of second matrix:\n");
    for(i = 0; i < r; i++)
    {
        for(j = 0; j < col; j++)
        {
            scanf("%d", &b[i][j]);
        }
    }

    printf("1 = Addition\n2 = Subtraction\nEnter your choice =");
    scanf("%d",&choice);

    switch(choice)
    {
        case 1:
            for(i = 0; i < r; i++)
            {
                for(j = 0;j < col;j++)
                {
                    c[i][j] = a[i][j] + b[i][j];
                }
            }
            printf("Addition of two matrices:\n");
            break;

        case 2:
            for(i = 0;i < r;i++)
            {
                for(j = 0;j < col;j++)
                {
                    c[i][j] = a[i][j] - b[i][j];
                }
            }
            printf("Subtraction of two matrices:\n");
            break;

        default:
            printf("Invalid Choice !\n");
            return 0;
    }

    for(i=0; i<r; i++)
{
    for(j=0; j<col; j++)
    {
        printf("%d ", c[i][j]);
    }
    printf("\n");
}
return 0;
}
